# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Single EVM deposit address (same address on Polygon, BSC, Arbitrum, Base)
DEPOSIT_ADDRESS=0xYourDepositAddress

# Legacy fallback if DEPOSIT_ADDRESS unset (prefer single DEPOSIT_ADDRESS)
ADMIN_WALLET_POLYGON=
ADMIN_WALLET_BSC=
ADMIN_WALLET_ARBITRUM=
ADMIN_WALLET_BASE=

# Per-chain RPC URLs (recommended). Falls back to ALCHEMY_API_KEY if unset.
POLYGON_RPC_URL=
BSC_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
ALCHEMY_API_KEY=your-alchemy-api-key

ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=

# Price oracle
COINGECKO_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bootstrap admin (comma-separated emails, auto-grant admin on login)
ADMIN_EMAILS=your-admin@email.com
