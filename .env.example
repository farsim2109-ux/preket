# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin wallet addresses (receive-only; no private keys in this app)
ADMIN_WALLET_POLYGON=0xYourPolygonAdminWallet
ADMIN_WALLET_BSC=0xYourBscAdminWallet
ADMIN_WALLET_ARBITRUM=0xYourArbitrumAdminWallet
ADMIN_WALLET_BASE=0xYourBaseAdminWallet

# Blockchain RPC / verification
ALCHEMY_API_KEY=your-alchemy-api-key
ETHERSCAN_API_KEY=your-etherscan-api-key
BSCSCAN_API_KEY=your-bscscan-api-key

# Price oracle
COINGECKO_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bootstrap admin (comma-separated emails, auto-grant admin on login)
ADMIN_EMAILS=your-admin@email.com
